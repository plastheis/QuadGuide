[Unit]
Description=quadguide flight guidance stack
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=@REPO_DIR@
ExecStartPre=/bin/mkdir -p @LOG_DIR@
# --log-level DEBUG: the service always runs at maximum verbosity, independent of
# the config file's logging.level (so bench/dev runs stay quieter). Everything
# goes to both @LOG_DIR@/<worker>.log and the journal (journalctl -u quadguide).
ExecStart=@PYTHON@ scripts/run.py --config @CONFIG@ --log-level DEBUG
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
LimitRTPRIO=99
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quadguide
# PYTHONFAULTHANDLER dumps a C-level traceback on a hard crash (a segfault in
# cv2/GStreamer), which a Python-level log can never capture. Both assignments
# share one Environment= line — systemd allows repeats, but configparser-based
# tooling (tests/unit/test_systemd_unit.py) does not.
Environment=PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1

[Install]
WantedBy=multi-user.target
