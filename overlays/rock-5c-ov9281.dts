// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
//
// Device-tree overlay: OmniVision OV9281 (1 MP mono global-shutter, RAW10) on
// the Radxa ROCK 5C (RK3588S2) MIPI-CSI connector.
//
// PROVENANCE — this is the rk2410 image's own OKDO-5MP/OV5647 camera overlay
// (`/boot/dtbo/rock-5a-okdo-5mp-camera.dtbo`, whose metadata explicitly lists
// `radxa,rock-5c`), reproduced fragment-for-fragment, with ONLY the sensor node
// swapped to the OV9281. The OV9281 is a 2-lane MIPI sensor exactly like the
// OV5647, so the dphy → csi2 → rkcif → isp wiring is identical and unchanged.
//
// Why not the earlier hand-built version: it carried two properties the OV9281
// driver rejects, which made the chip detect over I2C but never register its
// v4l2 subdev (so rkcif reported "get remote terminal sensor failed -19"):
//   * link-frequencies on the sensor endpoint — the out-of-tree ov9281 driver
//     validates this against its own table and aborts subdev registration if it
//     doesn't match. The reference omits it; so do we (driver uses its default).
//   * pinctrl-0 on the sensor node — caused "could not get default pinstate".
// Confirmed on-target facts baked in: I2C bus i2c3, pwdn GPIO1_D3 (0x1b)
// active-low, clock-names "xvclk" (the ov9281 driver requested this and bound).
//
// CLOCK FREQUENCY: the OKDO module declared 25 MHz; OV9281 nominal is 24 MHz and
// the module supplies its own oscillator (the sensor was detected over I2C with
// the fixed-clock at 24 MHz, so the value only informs the driver's timing math).
// If streaming framerate/exposure looks wrong, try 25000000 here.
//
// BUILD + INSTALL (on the board):
//   cd ~/quadguide && git pull
//   dtc -@ -I dts -O dtb -o /tmp/rock-5c-ov9281.dtbo overlays/rock-5c-ov9281.dts
//   sudo cp /tmp/rock-5c-ov9281.dtbo /boot/dtbo/rock-5c-ov9281.dtbo
//   sudo reboot          # (overlay already enabled in /boot/uEnv.txt)
// VERIFY after reboot:
//   media-ctl -d /dev/media0 -p | grep -i ov9281     # sensor now an ENTITY = fixed
//   the capture node is /dev/video0 (stream_cif_mipi_id0), mono Y10/GREY.

/dts-v1/;
/plugin/;

/ {
	metadata {
		title = "Enable OV9281 mono camera (ROCK 5C)";
		compatible = "radxa,rock-5a", "radxa,rock-5c";
		category = "camera";
		exclusive = "csi2_dphy0";
		description = "Enable OV9281 1MP mono global-shutter camera.";
	};

	fragment@0 {
		target-path = "/";
		__overlay__ {
			clk_cam_24m: external-camera-clock-24m {
				status = "okay";
				compatible = "fixed-clock";
				clock-frequency = <24000000>;
				clock-output-names = "clk_cam_24m";
				#clock-cells = <0>;
			};
		};
	};

	fragment@1 {
		target = <&i2c3>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			ov9281: ov9281@60 {
				status = "okay";
				compatible = "ovti,ov9281";
				reg = <0x60>;
				clocks = <&clk_cam_24m>;
				clock-names = "xvclk";
				pwdn-gpios = <&gpio1 0x1b 1>;
				rockchip,camera-module-index = <0>;
				rockchip,camera-module-facing = "back";
				rockchip,camera-module-name = "ov9281";
				rockchip,camera-module-lens-name = "default";

				port {
					ov9281_out: endpoint {
						remote-endpoint = <&mipidphy0_in_ucam1>;
						data-lanes = <1 2>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <&csi2_dphy0_hw>;
		__overlay__ { status = "okay"; };
	};

	fragment@3 {
		target = <&csi2_dphy0>;
		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					mipidphy0_in_ucam1: endpoint@2 {
						reg = <2>;
						remote-endpoint = <&ov9281_out>;
						data-lanes = <1 2>;
					};
				};
				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
					csidphy0_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&mipi2_csi2_input>;
					};
				};
			};
		};
	};

	fragment@4 {
		target = <&mipi2_csi2>;
		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					mipi2_csi2_input: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&csidphy0_out>;
					};
				};
				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
					mipi2_csi2_output: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&cif_mipi2_in0>;
					};
				};
			};
		};
	};

	fragment@5 {
		target = <&rkcif>;
		__overlay__ { status = "okay"; };
	};

	fragment@6 {
		target = <&rkcif_mipi_lvds2>;
		__overlay__ {
			status = "okay";
			port {
				cif_mipi2_in0: endpoint {
					remote-endpoint = <&mipi2_csi2_output>;
				};
			};
		};
	};

	fragment@7 {
		target = <&rkcif_mipi_lvds2_sditf>;
		__overlay__ {
			status = "okay";
			port {
				mipi_lvds2_sditf: endpoint {
					remote-endpoint = <&isp0_vir0>;
				};
			};
		};
	};

	fragment@8 {
		target = <&rkcif_mmu>;
		__overlay__ { status = "okay"; };
	};

	fragment@9 {
		target = <&isp0_mmu>;
		__overlay__ { status = "okay"; };
	};

	fragment@10 {
		target = <&rkisp0>;
		__overlay__ { status = "okay"; };
	};

	fragment@11 {
		target = <&rkisp0_vir0>;
		__overlay__ {
			status = "okay";
			port {
				#address-cells = <1>;
				#size-cells = <0>;
				isp0_vir0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&mipi_lvds2_sditf>;
				};
			};
		};
	};

	fragment@12 {
		target = <&pinctrl>;
		__overlay__ {
			camera {
				cam_pwdn_gpio: cam-pwdn-gpio {
					rockchip,pins = <1 0x1b 0 &pcfg_pull_up>;
				};
			};
		};
	};
};
